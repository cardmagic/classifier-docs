---
import DocsLayout from '../../../layouts/DocsLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return guides.map(entry => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();

const categoryLabels: Record<string, string> = {
  start: 'Start Here',
  choosing: 'Choosing a Classifier',
  bayes: 'Bayesian Classifier',
  lsi: 'LSI (Semantic Analysis)',
  knn: 'k-Nearest Neighbors',
  tfidf: 'TF-IDF Vectorizer',
  logisticregression: 'Logistic Regression',
  persistence: 'Persistence',
  extensions: 'Extensions',
  production: 'Production',
  cli: 'Command Line',
};

const faq = entry.data.faq;
const faqSchema = faq && faq.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
} : null;
---

{faqSchema && (
  <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
)}

<DocsLayout title={entry.data.title} description={entry.data.description}>
  <div class="mb-8 not-prose">
    <a href="/docs/guides" class="text-sm text-gray-500 hover:text-ruby transition-colors">
      ← Back to Guides
    </a>
  </div>

  <div class="not-prose mb-8">
    <div class="flex items-center gap-3 mb-4">
      <span class="text-sm font-medium px-3 py-1 rounded-full bg-gray-100 text-gray-700">
        {categoryLabels[entry.data.category]}
      </span>
    </div>
    <h1 class="text-4xl font-bold text-gray-900 mb-4">{entry.data.title}</h1>
    <p class="text-xl text-gray-600">{entry.data.description}</p>
  </div>

  <Content />
</DocsLayout>
