---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Text classification for Ruby made simple. Bayesian classification and semantic analysis with one gem." } = Astro.props;

const SITE = 'https://rubyclassifier.com';
const canonical = new URL(Astro.url.pathname, SITE).href.replace(/(.)\/$/, '$1');

const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareSourceCode',
  name: 'classifier',
  description:
    'Ruby text classification and semantic analysis: Naive Bayes, Latent Semantic Indexing, k-Nearest Neighbors, Logistic Regression, and TF-IDF vectorization, with the classifier and keywords command line tools.',
  programmingLanguage: 'Ruby',
  codeRepository: 'https://github.com/cardmagic/classifier',
  url: SITE,
  license: 'https://opensource.org/licenses/LGPL-2.1',
  softwareVersion: '2.7.0',
  dateModified: '2026-08-15',
  author: { '@type': 'Person', name: 'Lucas Carlson' },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <script type="application/ld+json" is:inline set:html={JSON.stringify(softwareSchema)} />

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-E65MEJ1C8B"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-E65MEJ1C8B');
    </script>
  </head>
  <body class="min-h-screen bg-white text-gray-900 flex flex-col">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
